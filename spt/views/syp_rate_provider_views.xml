<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="syp_rate_provider_search_view">
        <field name="name">syp.rate.provider.search</field>
        <field name="model">syp.rate.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="service" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="syp_rate_provider_list_view">
        <field name="name">syp.rate.provider.list</field>
        <field name="model">syp.rate.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="service" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="price_side" />
                <field name="scale" />
                <field name="update_schedule" />
                <field name="currency_ids" widget="many2many_tags" />
                <field name="last_successful_run" />
                <field name="sptoday_quota_remaining" optional="show" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="syp_rate_provider_form_view">
        <field name="name">syp.rate.provider.form</field>
        <field name="model">syp.rate.provider</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="%(syp_rate_update_wizard_action)d"
                        type="action"
                        string="Update Rates Now"
                        context="{'active_model': 'syp.rate.provider', 'active_ids': [id]}"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group name="options">
                        <group>
                            <field name="active" invisible="1" />
                            <field name="service" />
                            <field name="api_key" password="True" groups="base.group_system" />
                            <field name="price_side" />
                            <field name="scale" />
                            <field name="available_currency_ids" invisible="1" />
                            <field
                                name="currency_ids"
                                widget="many2many_tags"
                                options="{'no_create_edit': True}"
                                domain="[('id', 'in', available_currency_ids)]"
                            />
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                            <label for="interval_number" />
                            <div class="o_row">
                                <field name="interval_number" class="ml8" />
                                <field name="interval_type" />
                            </div>
                            <field name="last_successful_run" />
                            <field name="daily" invisible="1" />
                            <field name="next_run" invisible="daily" />
                        </group>
                    </group>
                    <group name="sptoday" string="SP Today" invisible="service != 'sptoday'">
                        <group>
                            <field name="sptoday_city" />
                        </group>
                        <group>
                            <field name="sptoday_quota_limit" />
                            <field name="sptoday_quota_remaining" />
                            <field name="sptoday_quota_reset" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_syp_rate_provider">
        <field name="name">Syrian Rate Providers</field>
        <field name="res_model">syp.rate.provider</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_syp_rate_provider"
        action="action_syp_rate_provider"
        parent="account.account_account_menu"
        sequence="32"
    />
</odoo>
