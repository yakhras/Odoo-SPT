<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="syp_rate_update_wizard_form" model="ir.ui.view">
        <field name="name">syp.rate.update.wizard.form</field>
        <field name="model">syp.rate.update.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="provider_ids" widget="many2many_tags" />
                    <field name="date_from" />
                    <field name="date_to" />
                </group>
                <div class="text-muted">
                    Each update calls the provider API once (shared by all selected providers),
                    and counts against the provider's quota.
                </div>
                <footer>
                    <button
                        name="action_update"
                        string="Update"
                        type="object"
                        default_focus="1"
                        class="oe_highlight"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="syp_rate_update_wizard_action" model="ir.actions.act_window">
        <field name="name">Update Syrian Rates</field>
        <field name="res_model">syp.rate.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="spt.model_syp_rate_provider" />
        <field name="binding_view_types">list</field>
    </record>
</odoo>
